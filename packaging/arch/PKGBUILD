# Maintainer: open-rmslist contributors

pkgname=open-rmslist
pkgver=0.1.0
pkgrel=1
pkgdesc="Winlink RMS gateway map with service-code filtering and propagation ranking"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/ben-kuhn/open-rmslist"
license=('MIT')
depends=()
makedepends=('go')
optdepends=('voacapl: point-to-point HF propagation forecasts (requires the itshfbc data)')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('e7c2a967956f7129f3d296985c4509836117ac13ec8f6f75f166a63e8cd9809a')

build() {
  cd "${pkgname}-${pkgver}"
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w -X main.version=${pkgver}" -o open-rmslist .
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 open-rmslist "${pkgdir}/usr/bin/open-rmslist"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 contrib/systemd/open-rmslist.service "${pkgdir}/usr/lib/systemd/system/open-rmslist.service"
  # The web UI is embedded in the binary; no separate assets to install.
}
