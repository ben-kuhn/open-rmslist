[Unit]
Description=RMS Radar — Winlink RMS gateway map
Documentation=https://github.com/ben-kuhn/rms-radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Create a dedicated user and a writable data directory, or use DynamicUser
# with StateDirectory (see the NixOS module in ../nix-ham-packages).
User=rms-radar
Group=rms-radar
# Bind to 127.0.0.1 for a private instance, or 0.0.0.0 to serve your LAN.
ExecStart=/usr/local/bin/rms-radar -d -listen 127.0.0.1:8079 -cache-dir /var/lib/rms-radar
Restart=on-failure
RestartSec=5

# Hardening (remove or relax if you need broader filesystem access).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rms-radar
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
